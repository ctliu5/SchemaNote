@using SchemaNote.ViewModels
@model OverviewViewModel

@{
    ViewData["Title"] = "Overview";
    Table t = new Table();
    int i = 0;
}

@section Scripts
{
    <script src="~/js/overview.js" asp-append-version="true"></script>
}
<div id="overview-data"
     data-objname-label="@Common.OBJ_Name"
     data-objname-json="@Model.TableNameJson"
     data-colname-label="@Common.COL_Name"
     data-colname-json="@Model.ColumnNameJson"
     data-description-label="@Common.OBJ_COL_ChineseName"
     data-description-json="@Model.DescriptionJson"
     data-remark-label="@Common.OBJ_COL_Remark"
     data-remark-json="@Model.RemarkJson"
     data-flags="@Model.FlagsJson"
     data-allflags="@Model.AllFlagsJson"></div>
<div class="overview-sticky-header mb-2">
    <div class="d-flex align-items-baseline gap-2 mb-2 mt-3 flex-wrap">
        <h2 class="mb-0">Overview</h2>
        @{
            string ovServer = ViewData["CurrentServer"] as string ?? string.Empty;
            string ovDatabase = ViewData["CurrentDatabase"] as string ?? string.Empty;
        }
        @if (!string.IsNullOrEmpty(ovServer) || !string.IsNullOrEmpty(ovDatabase))
        {
            <span class="h4 mb-0 text-muted">（@ovServer／@ovDatabase）</span>
        }
    </div>
    @if (Model.ADO_dot_NET > 0)
    {
        <h2>ADO_dot_NET:@Model.ADO_dot_NET 毫秒</h2>
        <h2>Dapper:@Model.Dapper 毫秒</h2>
        <h2>ADO_dot_NET2:@Model.ADO_dot_NET2 毫秒</h2>
        <h2>ADO_dot_NET3:@Model.ADO_dot_NET3 毫秒</h2>
        <h2>ADO_dot_NET4:@Model.ADO_dot_NET4 毫秒</h2>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <h4 class="bg-danger">@Html.Raw(TempData["ErrorMessage"])</h4>
    }

    <div class="d-flex flex-wrap align-items-center gap-2 search">
        <div class="d-flex align-items-center gap-2">
            <label>標籤</label>
            <div class="dropdown" id="flags-filter">
                <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                    篩選標籤
                </button>
                <div class="dropdown-menu p-2" id="flags-menu" style="max-height:300px;overflow-y:auto;min-width:220px;">
                    <!-- 標籤核取項目由 JS 動態產生 -->
                </div>
            </div>
            <div id="flags-selected" class="d-flex flex-wrap gap-1"></div>
            <label for="choose">搜尋項目</label>
            <select id="choose" class="form-select w-auto"></select>
            <label for="switch">搜索方式</label>
            <select id="switch" class="form-select w-auto">
                <option value="fuzzy" selected>模糊搜索</option>
                <option value="exact">精確搜索</option>
            </select>
            <input id="SearchTextBox" type="text" class="form-control w-auto" placeholder="Enter key words..." />
        </div>
        <div class="d-flex align-items-center gap-2 ms-auto">
            <span class="count" data-bs-toggle="tooltip" data-bs-placement="bottom" title="@Common.ToolTip擴充屬性Excel">
                <input type="button" class="btn btn-outline-secondary" onclick="ExportExcel()" value="💾Excel" />
            </span>
            <span class="count" data-bs-toggle="tooltip" data-bs-placement="bottom" title="@Common.ToolTip擴充屬性Markdown">
                <input type="button" class="btn btn-outline-secondary" onclick="ExportMarkdown()" value="💾Markdown" />
            </span>
            <span class="count" data-bs-toggle="tooltip" data-bs-placement="bottom" title="@Common.ToolTip擴充屬性SQL">
                <input type="button" class="btn btn-outline-secondary" onclick="ExportExtendedPropScript()" value="💾擴充屬性SQL" />
            </span>
        </div>
    </div>
</div>
@foreach (var item in Model.Tables)
{
    i++;
    <div class="card accordion mb-2" id="@Html.Raw(Common.accordion + i)" data-object-id="@item.OBJECT_ID" role="tablist" aria-multiselectable="true">
        <div class="card">
            <div class="card-header cus_panel-heading" role="tab">
                <span class="panel-title" role="button" data-bs-toggle="collapse" data-bs-target="#@Html.Raw("collapse" + i)" aria-expanded="false" aria-controls="@Html.Raw("collapse" + i)">
                    <span class="me-1">▸</span>
                    <strong class="objName">
                        @Html.DisplayFor(modelItem => item.NAME)
                    </strong>
                </span>
                <a class="description text-primary" asp-action="Details" asp-route-id="@item.OBJECT_ID">
                    <partial name="_ValueOrDefault" model="item.MS_Description" />
                </a>
                <span class="count" data-bs-toggle="tooltip" data-bs-placement="top" title="@Common.CountTip">
                    @Html.DisplayNameFor(model => t.QTY):<strong class="text-primary">@Html.DisplayFor(modelItem => item.QTY)</strong>
                </span>
            </div>
            <div id="@Html.Raw("collapse" + i)" class="card-body collapse tabDetail" role="tabpanel">
                <partial name="_ObjectMetaTable" model="item" />
                <div class="tabDetail_right">
                    <div>
                        @Html.DisplayNameFor(model => t.REMARK)
                    </div>
                    <div>
                        <a class="remark text-primary" asp-action="Details" asp-route-id="@item.OBJECT_ID">
                            <partial name="_ValueOrDefault" model="item.REMARK" />
                        </a>
                    </div>
                </div>
            </div>
            <table class="table table-hover subTable">
                <partial name="_OverviewColumns" model="item.Columns" view-data="@(new ViewDataDictionary(ViewData) { { "TYPE", item.TYPE } })" />
                @*  ↓↓↓equal↓↓↓↓
                    @{await Html.RenderPartialAsync("_OverviewColumns", item.Columns);}
                *@
            </table>
        </div>
    </div>
}
