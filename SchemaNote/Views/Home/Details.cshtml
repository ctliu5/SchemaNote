@using SchemaNote.ViewModels;
@model DetailsViewModel

@{
    ViewData["Title"] = "Details";
}

@section Scripts
    {
    <script>
        /*
        https://developer.mozilla.org/en-US/docs/Glossary/IIFE
        IIFE vs window.onload vs jQuery $(document).ready
        https://stackoverflow.com/questions/9899372/pure-javascript-equivalent-of-jquerys-ready-how-to-call-a-function-when-t
        */
        (function () {
            var htmlCollection = document.getElementsByClassName("NoteField");
            if (htmlCollection.length > 0) {
                var arr = Array.prototype.slice.call(htmlCollection);
                arr.forEach(
                    function (item) {
                        item.addEventListener("dblclick", changeElement);
                    }
                )
            }
        })();
        function EditAll() {
            var htmlCollection = document.getElementsByClassName("NoteField");
            if (htmlCollection.length > 0) {
                var arr = Array.prototype.slice.call(htmlCollection);
                arr.forEach(
                    function (item) {
                        var doubleClickEvent = document.createEvent('MouseEvents');
                        doubleClickEvent.initEvent('dblclick', true, true);
                        item.dispatchEvent(doubleClickEvent);
                    }
                )
                document.getElementById('EditAll').style.cssText = 'display:none;';
            }
        }
    </script>
    <script>
        // 標籤（FLAGS）編輯器：multiple select + 新增文字框，同步隱藏 input [0].FLAGS
        (function () {
            var SEP = ';';
            var list = document.getElementById('flags-list');
            var hidden = document.getElementById('flags-hidden');
            var input = document.getElementById('flags-new');
            var addBtn = document.getElementById('flags-add');
            var removeBtn = document.getElementById('flags-remove');
            if (!list || !hidden) return;

            function showSubmit() {
                var submit = document.getElementById('submit');
                if (submit) submit.style.cssText = 'display:initial;';
            }
            function syncHidden() {
                var values = [];
                for (var i = 0; i < list.options.length; i++) {
                    values.push(list.options[i].value);
                }
                hidden.value = values.join(SEP);
                showSubmit();
            }
            function addFlag() {
                // 保留標籤前後空白，只忽略完全空字串；避免包含分號
                var val = input.value;
                if (!val || val.indexOf(SEP) > -1) { input.value = ''; return; }
                for (var i = 0; i < list.options.length; i++) {
                    if (list.options[i].value === val) { input.value = ''; return; }
                }
                var opt = document.createElement('option');
                opt.value = val;
                opt.text = val;
                opt.selected = true;
                list.appendChild(opt);
                input.value = '';
                syncHidden();
            }
            function removeSelected() {
                for (var i = list.options.length - 1; i >= 0; i--) {
                    if (list.options[i].selected) list.remove(i);
                }
                syncHidden();
            }
            if (addBtn) addBtn.addEventListener('click', addFlag);
            if (removeBtn) removeBtn.addEventListener('click', removeSelected);
            if (input) input.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); addFlag(); }
            });
        })();
    </script>
}
<h2>Details</h2>
@if (TempData["ErrorMessage"] != null)
{
    <h4 class="bg-danger">@Html.Raw(TempData["ErrorMessage"])</h4>
}
<div>
    <a asp-action="Overview" class="btn btn-outline-dark"><strong>&lt; </strong>Overview</a>
    <button id="EditAll" type="button" class="btn btn-info" onclick="EditAll();">編輯全部</button>
</div>
<br />
<form asp-action="Details" onsubmit="EmptyString('@Common.DefaultValue')" method="post" class="card">
    <input name="[0].COLUMN_ID" value="0" style="display:none;" />
    <div class="card-header">
        <stron class="objName">
            @Html.DisplayFor(n => Model.NAME)
        </stron>
        <sapn class="NoteField"
              data-field="@Common.MS_Desc"
              data-content="@Model.MS_Description"
              data-column_id="0"
              data-sortnum="0"
              data-class="form-control tabMS_Description">
            @if (Model.MS_Description == Common.DefaultValue)
            {
                <code>
                    @Html.DisplayFor(n => Model.MS_Description)
                </code>
            }
            else
            {
                @Html.DisplayFor(n => Model.MS_Description)
            }
            @Html.ValidationMessageFor(model => model.MS_Description, null, new { data_valmsg_for = "[0].MS_Description" })
        </sapn>
        <button type="submit" id="submit" class="btn btn-primary" style="display:none;">提交</button>
        <span class="count" data-bs-toggle="tooltip" data-bs-placement="top" title="@Common.CountTip">
            @Html.DisplayNameFor(model => Model.QTY):<strong class="text-primary">@Html.DisplayFor(modelItem => Model.QTY)</strong>
        </span>
    </div>
    <div class="card-body">
        <table class="tabDetail_left">
            <tbody>
                <tr>
                    <td>
                        @Html.DisplayNameFor(model => Model.TYPE_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => Model.TYPE_NAME)
                    </td>
                </tr>
                <tr>
                    <td>
                        @Html.DisplayNameFor(model => Model.SCHEMA_NAME)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => Model.SCHEMA_NAME)
                    </td>
                </tr>
                <tr>
                    <td>
                        @Html.DisplayNameFor(model => Model.CREATE_DATE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => Model.CREATE_DATE)
                    </td>
                </tr>
                <tr>
                    <td>
                        @Html.DisplayNameFor(model => Model.MODIFY_DATE)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => Model.MODIFY_DATE)
                    </td>
                </tr>
                <tr>
                    <td>
                        @Html.DisplayNameFor(model => Model.FLAGS)
                    </td>
                    <td>
                        <div id="flags-editor">
                            <select id="flags-list" class="form-select" multiple size="4">
                                @foreach (var flag in Model.FlagList)
                                {
                                    <option value="@flag" selected>@flag</option>
                                }
                            </select>
                            <div class="input-group mt-1">
                                <input id="flags-new" type="text" class="form-control" placeholder="輸入標籤後按新增" />
                                <button id="flags-add" type="button" class="btn btn-outline-secondary">新增</button>
                                <button id="flags-remove" type="button" class="btn btn-outline-danger">刪除選取</button>
                            </div>
                            <input id="flags-hidden" name="[0].FLAGS" type="hidden" value="@Model.FLAGS" />
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
        <div class="tabDetail_right">
            <div>
                @Html.DisplayNameFor(model => Model.REMARK)
            </div>
            <div class="NoteField"
                 data-field="@Common.Remark"
                 data-content="@Model.REMARK"
                 data-column_id="0"
                 data-sortnum="0"
                 data-class="form-control">
                @if (Model.REMARK == Common.DefaultValue)
                {
                    <code>
                        @Html.DisplayFor(n => Model.REMARK)
                    </code>
                }
                else
                {
                    @Html.DisplayFor(n => Model.REMARK)
                }
                @Html.ValidationMessageFor(model => model.REMARK, null, new { data_valmsg_for = "[0].REMARK" })
            </div>
        </div>
    </div>
    <table class="table table-bordered table-hover table-responsive subTable">
        <partial name="_DetailColumns" model="Model.Columns" />
        @*  ↓↓↓equal↓↓↓↓
            @{await Html.RenderPartialAsync("_DetailColumns", Model.Columns);}
        *@
    </table>
</form>