@using Microsoft.AspNetCore.Http.Features

@{
    var consentFeature = Context.Features.Get<ITrackingConsentFeature>();
    var showBanner = !consentFeature?.CanTrack ?? false;
    var cookieString = consentFeature?.CreateConsentCookie();
}

@if (showBanner)
{
    <nav id="cookieConsent" class="navbar navbar-expand-sm navbar-light bg-light fixed-top" role="alert">
        <div class="container">
            <span class="navbar-brand">ℹ️</span>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#cookieConsentCollapse" aria-controls="cookieConsentCollapse" aria-expanded="false" aria-label="Toggle cookie consent banner">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="cookieConsentCollapse">
                <p class="navbar-text me-auto mb-0">
                    Use this space to summarize your privacy and cookie use policy.
                </p>
                <div class="d-flex">
                    <a asp-controller="Home" asp-action="Privacy" class="btn btn-info me-2">Learn More</a>
                    <button type="button" class="btn btn-outline-dark" data-cookie-string="@cookieString">Accept</button>
                </div>
            </div>
        </div>
    </nav>
    <script>
        (function () {
            document.querySelector("#cookieConsent button[data-cookie-string]").addEventListener("click", function (el) {
                document.cookie = el.target.dataset.cookieString;
                document.querySelector("#cookieConsent").classList.add("d-none");
            }, false);
        })();
    </script>
}