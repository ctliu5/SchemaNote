@* 直接連線用的隱藏表單：點擊已儲存連線按鈕時，填入連線字串並送出（走 PRG） *@
<form id="savedConnConnectForm" asp-controller="Home" asp-action="Overview" method="post" class="d-none">
    <input type="hidden" name="ConnectionString" id="savedConnConnectInput" />
</form>

@* 記住DB連線 Modal 彈出視窗 *@
<div class="modal fade" id="rememberDbModal" tabindex="-1" aria-labelledby="rememberDbModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rememberDbModalLabel">記住DB連線</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <small class="text-muted">
                        Server：<span id="rememberDbServer"></span><br />
                        Database：<span id="rememberDbDatabase"></span>
                    </small>
                </div>
                <div class="mb-3">
                    <label for="rememberDbName" class="form-label">連線名稱</label>
                    <input type="text" class="form-control" id="rememberDbName" required />
                    <div class="invalid-feedback">請輸入連線名稱。</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">略過</button>
                <button type="button" class="btn btn-primary" id="rememberDbSaveBtn">儲存</button>
            </div>
        </div>
    </div>
</div>