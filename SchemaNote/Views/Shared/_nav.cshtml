@using SchemaNote.ViewModels;
@model IConnString

@{
    string currentServer = ViewData["CurrentServer"] as string ?? string.Empty;
    string currentDatabase = ViewData["CurrentDatabase"] as string ?? string.Empty;
    string currentConnString = ViewData["CurrentConnectionString"] as string ?? string.Empty;
}

<div class="card connstring-sticky" role="tablist">
    <div class="card-header" role="tab" id="collapseListGroupHeading">
        <h6 class="mb-0">
            <a class="collapsed" role="button" data-bs-toggle="collapse" href="#collapseListGroup" aria-expanded="false" aria-controls="collapseListGroup">
                Connection String Manager
            </a>
        </h6>
    </div>
    <div id="collapseListGroup" class="collapse" role="tabpanel" aria-labelledby="collapseListGroupHeading">
        <div class="card-body">
            <form asp-controller="Home" asp-action="Overview" method="post">
                <div class="input-group mb-3">
                    <input asp-for="ConnectionString" class="form-control" required placeholder="請輸入連線字串" />
                    <span asp-validation-for="ConnectionString" class="text-danger"></span>
                    <button class="btn btn-outline-secondary" type="submit"> &nbsp; Let's Connect &nbsp;</button>
                    <button type="button" class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false"></button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#">📤匯出連線清單</a></li>
                        <li><a class="dropdown-item" href="#">📥匯入連線清單</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#">🧹移除連線清單</a></li>
                    </ul>
                </div>
                @* 已儲存的連線（來自 localStorage），由 site.js 動態渲染；點按鈕直接連線，右上 x 可刪除 *@
                <span id="savedConnList" class="d-inline-flex flex-wrap gap-2 align-items-center ms-2 align-middle"></span>
            </form>
        </div>
    </div>
</div>

@* 供 site.js 讀取目前成功連線的資訊，用來判斷是否需要彈出「記住DB連線」視窗。data-connstring 為 AES 密文 *@
<div id="currentConnInfo"
     data-server="@currentServer"
     data-database="@currentDatabase"
     data-connstring="@currentConnString"
     hidden></div>

<partial name="_remDbModal" />