@using SchemaNote.ViewModels;
@model IConnString

@{
    string currentServer = ViewData["CurrentServer"] as string ?? string.Empty;
    string currentDatabase = ViewData["CurrentDatabase"] as string ?? string.Empty;
    string currentConnString = ViewData["CurrentConnectionString"] as string ?? string.Empty;
}

<div class="card connstring-sticky" role="tablist">
    <div class="card-header" role="tab" id="collapseListGroupHeading">
        <h6 class="mb-0">
            <a class="collapsed" role="button" data-bs-toggle="collapse" href="#collapseListGroup" aria-expanded="false" aria-controls="collapseListGroup">
                Connection String Manager
            </a>
        </h6>
    </div>
    <div id="collapseListGroup" class="collapse" role="tabpanel" aria-labelledby="collapseListGroupHeading">
        <div class="card-body">
            @* 連線方式切換：預設為「四欄位」模式，可切換為「連線字串」模式 *@
            <div class="btn-group btn-group-sm mb-3" role="group" aria-label="連線方式切換">
                <input type="radio" class="btn-check" name="connMode" id="connModeString" value="string" autocomplete="off" checked>
                <label class="btn btn-outline-secondary" for="connModeString">🔗 連線字串</label>
                <input type="radio" class="btn-check" name="connMode" id="connModeFields" value="fields" autocomplete="off">
                <label class="btn btn-outline-secondary" for="connModeFields">📝 填寫欄位</label>
            </div>

            @* 四欄位模式：填寫 server / database / uid / pwd，後端組回連線字串 *@
            <form id="connFieldsForm" asp-controller="Home" asp-action="OverviewByFields" method="post">
                <div class="mb-2">
                    <label class="form-label mb-1" for="fieldServer">Server</label>
                    <input type="text" class="form-control" id="fieldServer" name="Server" placeholder="例如：localhost 或 127.0.0.1,1433" />
                </div>
                <div class="mb-2">
                    <label class="form-label mb-1" for="fieldDatabase">Database</label>
                    <input type="text" class="form-control" id="fieldDatabase" name="Database" placeholder="資料庫名稱" />
                </div>
                <div class="mb-2">
                    <label class="form-label mb-1" for="fieldUid">Uid</label>
                    <input type="text" class="form-control" id="fieldUid" name="Uid" placeholder="登入帳號" autocomplete="username" />
                </div>
                <div class="mb-3">
                    <label class="form-label mb-1" for="fieldPwd">Pwd</label>
                    <input type="password" class="form-control" id="fieldPwd" name="Pwd" placeholder="登入密碼" autocomplete="current-password" />
                </div>
                <button class="btn btn-outline-secondary w-100" type="submit">🔌&nbsp; Let's Connect &nbsp;</button>
            </form>

            @* 連線字串模式：直接輸入完整 SQL Server 連線字串 *@
            <form id="connStringForm" class="d-none" asp-controller="Home" asp-action="Overview" method="post">
                <div class="input-group mb-3">
                    <input asp-for="ConnectionString" class="form-control" placeholder="請輸入 SQL Server 連線字串" />
                    <span asp-validation-for="ConnectionString" class="text-danger"></span>
                    <button class="btn btn-outline-secondary" type="submit">🔌&nbsp; Let's Connect &nbsp;</button>
                    <button type="button" class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false"></button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#" id="exportConnBtn">↪️ 匯出連線清單</a></li>
                        <li><a class="dropdown-item" href="#" id="importConnBtn">↩️ 匯入連線清單</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item text-danger" href="#" id="removeConnBtn">🗑移除連線清單</a></li>
                    </ul>
                </div>
                @* 已儲存的連線（來自 localStorage），由 site.js 動態渲染；點按鈕直接連線，右上 x 可刪除 *@
                <span id="savedConnList" class="d-inline-flex flex-wrap gap-2 align-items-center ms-2 align-middle"></span>
            </form>
        </div>
    </div>
</div>

@* 供 site.js 讀取目前成功連線的資訊，用來判斷是否需要彈出「記住DB連線」視窗。data-connstring 為 AES 密文 *@
<div id="currentConnInfo"
     data-server="@currentServer"
     data-database="@currentDatabase"
     data-connstring="@currentConnString"
     hidden></div>

<partial name="_remDbModal" />
<partial name="_connListModals" />